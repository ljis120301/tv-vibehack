<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
  The defaults below suit a Fire TV (no tuner); see FIRETV.md.
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.netflix.ninja</item>
        <item>com.google.android.youtube.tv</item>
        <item>com.disneyplus</item>
    </string-array>

    <!-- Apps never shown as tiles (Amazon shelf/store shortcuts on Fire TV). -->
    <string-array name="hidden_apps">
        <item>com.amazon.shoptv.firetv.client</item>
        <item>com.amazon.imdb.tv.android.app</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Empty on a streaming stick. -->
    <string name="live_tv_package" translatable="false"></string>

    <!-- Tiles per row in the grid; the dock always has this many slots. Below 4 the row keeps four-column tile
         spacing and is centred, e.g. 2 for a stick with two apps. -->
    <integer name="columns">4</integer>
</resources>
