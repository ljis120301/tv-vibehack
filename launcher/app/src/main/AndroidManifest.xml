<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Needed on Android 10 to read the Wi-Fi network name; granted over adb at install time. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Fire TV: HomeWatchService follows ActivityManager's log to catch Home; granted over adb, see FIRETV.md. -->
    <uses-permission android:name="android.permission.READ_LOGS"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 9+: startForeground() throws SecurityException without it (Fire OS 7/8). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Fire TV: HomeWatchService's cover over Amazon's home; app-op set over adb. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.TvHome"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Screensaver: pick it in Settings, or `settings put secure screensaver_components
             com.gathin.tvhome/.ClockDream` over adb. -->
        <service
            android:name=".ClockDream"
            android:label="@string/dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>


        <!-- Fire TV: puts this launcher back over Amazon's home whenever the system opens it. See FIRETV.md. -->
        <service
            android:name=".HomeWatchService"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <!-- Boot broadcasts are ordered: ask to be early in the queue. -->
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
